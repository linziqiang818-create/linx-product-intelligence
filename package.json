{
  "name": "linx",
  "version": "2.0.0",
  "private": true,
  "description": "LINX 家具选品工作台：三空间（产品库 → 适配池 → 第二大脑）+ 本地 SQLite 数据服务",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tests/*.test.mjs\"",
    "scan": "node server/gap-scan.mjs",
    "vision": "node server/vision.mjs",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-desktop-shortcut.ps1"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
